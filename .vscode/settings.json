{
  "pasteImage.path": "${projectRoot}/assets/${currentFileNameWithoutExt}",
  "pasteImage.basePath": "${projectRoot}",
  "pasteImage.forceUnixStyleSeparator": true,
  "pasteImage.prefix": "",
  "pasteImage.encodePath": "urlEncodeSpace",
  "pasteImage.showFilePathConfirmInputBox": true,
  "pasteImage.filePathConfirmInputBoxMode": "onlyName",
  "pasteImage.defaultName": "Y-MM-DD-HH-mm-ss",
  "pasteImage.insertPattern": "![${imageFileNameWithoutExt}]({{ '/${imageFilePath}' | relative_url }})",
  "files.exclude": {
    "**/.jekyll-cache": true,
    "**/_site": true,
    "**/ruby31": true,
    "**/tmp": true,
    "**/vendor": true
  },
  "search.exclude": {
    "**/.jekyll-cache": true,
    "**/_site": true,
    "**/ruby31": true,
    "**/tmp": true,
    "**/vendor": true
  }
}
